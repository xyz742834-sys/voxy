#version 460
#extension GL_ARB_gpu_shader_int64 : enable

// 統合描画版の cmdgen (Vulkan 専用)。lod/gl46/cmdgen.comp に対応する。
//
// == GL 版との違い ==
//   GL 版  セクションごとに最大 7 個の DrawCommand を atomicAdd で確保して書く
//   ここ   セクションごとに 7 個の **テーブルエントリ** を固定スロットに書く
//
// DrawCommand を書かないので writeCmd() が丸ごと消え、atomicAdd も消える。
// 実際の draw は面の数だけ (7 本) で、prefix sum の後に merged_prefix.comp が書く。
//
// == スロットが固定である理由 ==
// エントリのスロットは face * sectionCount + i で決まる (i は indirectLookup 内の添字)。
// quad 数 0 の面も長さ 0 のエントリとしてスロットを占める。
//
// atomicAdd で詰めて並べると **同じ入力でも実行ごとに並びが変わる**。
// そうなると「CPU が作ったテーブルと GPU が作ったテーブルが一致するか」を
// バイト単位で比べられなくなり、Stage 3 の検証手段が 1 つ失われる。
// 密なら atomic が不要で、CPU と GPU がまったく同じ配列を作る。
//
// == 面方向マスク (msk) ==
// GL 版の msk 構築をそのまま維持している。カメラのセクション座標から見て
// 裏を向いている面を落とすもので、深度バッファにもラスタパスにも依存しない。
// CPU 側 (SyntheticTerrain.faceMask) と同じ規則でなければ差分が出る。

layout(local_size_x = 128) in;

#define SECTION_METADATA_BUFFER_BINDING 3
#define VISIBILITY_BUFFER_BINDING 4
#define INDIRECT_SECTION_LOOKUP_BINDING 5
#define POSITION_SCRATCH_BINDING 6
#define POSITION_SCRATCH_ACCESS writeonly

#import <voxy:lod/section.glsl>
#import <voxy:lod/gl46/bindings.glsl>

layout(binding = MERGED_ENTRY_BINDING, std430) writeonly restrict buffer MergedEntryBuffer {
    uvec2 mergedEntries[];
};

// 走査前は「エントリごとの quad 数」、merged_prefix.comp が同じ配列を prefix に書き換える。
// 別配列にしないのは、単一ワークグループの in-place 走査で足りるため。
layout(binding = MERGED_PREFIX_BINDING, std430) restrict buffer MergedPrefixBuffer {
    uint mergedEntryCount;
    uint mergedCounts[];
};

// temporal: 「前フレームは不可視だった」セクションだけを残した quad 数。
// **エントリ配列は共有する** — ランの (quadStart, drawId) は不透明とまったく同じで、
// 違うのは数だけだから [確認済 — GL 版 cmdgen も同じ ptr/count で writeCmd している]。
layout(binding = TEMPORAL_PREFIX_BINDING, std430) restrict buffer TemporalPrefixBuffer {
    uint temporalEntryCount;
    uint temporalCounts[];
};

// 半透明。距離バケットの計数と、半透明 quad を持つセクションの登録。
//
// == 不透明と違い atomicAdd を使う ==
// バケットは 1024 本あり、セクション数 x 1024 の密な配列は現実的でない。
// GL 版も atomicAdd でスロットを取るので **バケット内の順序は実行ごとに変わる**
// [確認済 — lod/gl46/cmdgen.comp / buildtranslucents.comp]。
// これは上流の設計判断であり、移植側で決定的にすると挙動が変わってしまう。
// 代わりに合成データ側で「半透明 quad が画面上で重ならない」ことを規約にする
// (docs/phase4-stage1-completion.md 5.1 の 2 本目)。
layout(binding = TRANSLUCENT_BUCKET_BINDING, std430) restrict buffer TranslucentBucketBuffer {
    uint bucketCount[];
};
layout(binding = TRANSLUCENT_LIST_BINDING, std430) restrict buffer TranslucentListBuffer {
    uint translucentSectionCount;
    uint translucentSections[];
};

// temporal かどうかはセクション単位で決まるのでグローバルに持つ
bool renderTemporally = false;

void writeEntry(uint face, uint slotIndex, uint quadStart, uint count) {
    uint slot = face * sectionCount + slotIndex;
    mergedEntries[slot] = uvec2(quadStart, slotIndex);
    mergedCounts[slot] = count;
    temporalCounts[slot] = renderTemporally ? count : 0u;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= sectionCount) {
        return;
    }

    uint sid = indirectLookup[i];
    SectionMeta meta = sectionData[sid];
    uint detail = extractDetail(meta);
    ivec3 ipos = extractPosition(meta);

    // 頂点シェーダは positionBuffer[drawId] を引く。drawId は indirectLookup 内の添字
    positionBuffer[i] = extractRawPos(meta);

    uint dat = visibilityData[sid];
    bool shouldRender = (dat & 0x7fffffffu) == frameId;
    // bit 31 は cull が立てる「前フレームも可視だった」印。
    // 立っていない = 今フレーム新たに見えた -> temporal パスで描く
    // [確認済 — lod/gl46/cmdgen.comp:67 と cull/raster.vert:55-56]
    renderTemporally = (dat & 0x80000000u) == 0u;

    ivec3 relative = ipos - (baseSectionPos >> int(detail));
    uvec4 counts = meta.b;

    uint msk = 0u;
    msk |= uint(((counts.y      & 0xFFFFu) != 0u) && (relative.y > -1)) << 0;
    msk |= uint((((counts.y>>16)& 0xFFFFu) != 0u) && (relative.y <  1)) << 1;
    msk |= uint(((counts.z      & 0xFFFFu) != 0u) && (relative.z > -1)) << 2;
    msk |= uint((((counts.z>>16)& 0xFFFFu) != 0u) && (relative.z <  1)) << 3;
    msk |= uint(((counts.w      & 0xFFFFu) != 0u) && (relative.x > -1)) << 4;
    msk |= uint((((counts.w>>16)& 0xFFFFu) != 0u) && (relative.x <  1)) << 5;
    msk |= uint(((counts.x>>16) & 0xFFFFu) != 0u) << 6;

    if (!shouldRender) {
        msk = 0u;
    }

    // ジオメトリ内のラン順: 半透明 -> 両面 -> DOWN -> UP -> NORTH -> SOUTH -> WEST -> EAST
    // 半透明は不透明経路に出さないが **ptr は進める**
    uint ptr = extractQuadStart(meta) + (counts.x & 0xFFFFu);

    uint c = (counts.x>>16) & 0xFFFFu;
    writeEntry(6u, i, ptr, ((msk & (1u<<6)) != 0u) ? c : 0u);
    ptr += c;

    c = counts.y & 0xFFFFu;
    writeEntry(0u, i, ptr, ((msk & (1u<<0)) != 0u) ? c : 0u);
    ptr += c;

    c = (counts.y>>16) & 0xFFFFu;
    writeEntry(1u, i, ptr, ((msk & (1u<<1)) != 0u) ? c : 0u);
    ptr += c;

    c = counts.z & 0xFFFFu;
    writeEntry(2u, i, ptr, ((msk & (1u<<2)) != 0u) ? c : 0u);
    ptr += c;

    c = (counts.z>>16) & 0xFFFFu;
    writeEntry(3u, i, ptr, ((msk & (1u<<3)) != 0u) ? c : 0u);
    ptr += c;

    c = counts.w & 0xFFFFu;
    writeEntry(4u, i, ptr, ((msk & (1u<<4)) != 0u) ? c : 0u);
    ptr += c;

    c = (counts.w>>16) & 0xFFFFu;
    writeEntry(5u, i, ptr, ((msk & (1u<<5)) != 0u) ? c : 0u);

    // 半透明は面方向マスクの対象外 (両面描画なので) [確認済 — GL 版も msk を見ていない]
    uint tCount = counts.x & 0xFFFFu;
    if (shouldRender && tCount != 0u) {
        uint slot = atomicAdd(translucentSectionCount, 1u);
        translucentSections[slot] = i;

        // 距離バケット。**遠いほど小さい番号**にして遠くから描く
        uvec3 absRel = uvec3(abs(relative));
        uint dist = (absRel.x + absRel.y + absRel.z) << detail;
        dist = (TRANSLUCENT_BUCKETS - 1u) - min(dist, TRANSLUCENT_BUCKETS - 1u);
        atomicAdd(bucketCount[dist], 1u);
    }
}
